{
  "name": "agh-motion",
  "version": "1.0.0",
  "private": true,
  "description": "AGH German Pathway — reusable Remotion motion-graphics template (9:16, 1080x1920, 30 fps).",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render WorldOfWork exports/agh-world-of-work.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "cover": "remotion still Cover exports/agh-world-of-work-cover.png --frame=0",
    "frames": "node scripts/qc-frames.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/layout-utils": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "^5.6.0"
  }
}
